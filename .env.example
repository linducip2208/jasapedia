APP_NAME=Jasapedia
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id-ID
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


# Jasapedia services
SERVICES_PAYMENTS_DRIVER=sandbox
SERVICES_PAYMENTS_SANDBOX_SECRET=change-me-in-production
SERVICES_AI_DRIVER=null

# Search engine (sql | meilisearch)
SEARCH_DRIVER=sql
MEILISEARCH_HOST=
MEILISEARCH_KEY=

# Media storage disk (public | s3 | r2)
MEDIA_DISK=public
MEDIA_MAX_SIZE_KB=4096

# Geo / map vendor (frontend concern only)
GEO_DRIVER=haversine
MAP_PROVIDER=openstreetmap

# Payment production adapters (never commit credentials)
PAYMENT_DRIVER=sandbox
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

